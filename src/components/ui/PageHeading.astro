---
interface Props {
  title: string;
  /** Optional: a project page puts it on the back of the screenshot instead. */
  description?: string;
  /** 2 for a section heading on the one-pager; 1 for a standalone page. */
  level?: 1 | 2;
}

const { title, description, level = 1 } = Astro.props;
const Heading = level === 2 ? 'h2' : 'h1';
---

<header class:list={['page-heading', 'content', !description && 'is-bare']} data-heading>
  <div class="page-heading__title-wrap">
    <Heading class="creative page-heading__title" data-text={title}>{title}</Heading>
  </div>
  {
    description && (
      <p class="page-heading__description">
        <span class="typed" data-typed>
          <span class="typed__real">{description}</span>
          <span class="typed__mask" aria-hidden="true" />
        </span>
      </p>
    )
  }
</header>

<style>
  .page-heading__title-wrap {
    width: fit-content;
  }

  /* With no description under it, `.content`'s 100px leaves the title marooned
     above whatever follows — a project page's screenshot, in practice. */
  .page-heading.is-bare {
    padding-bottom: 1.5rem;
  }

  /* Section headings are h2s on the one-pager — hold the h1 size either way. */
  .page-heading__title {
    font-size: 2.5rem;
  }

  /* Outlined title with an orange fill that wipes across when it scrolls in. */
  .creative {
    position: relative;
    color: var(--colour-bg);
    -webkit-text-stroke: 3px #383d52;
  }

  /* The fill layer always sits at the title's full size and wraps exactly as
     the outline underneath does; the wipe is a clip, not a width. Growing the
     width instead re-flows this text on every frame, and at the end of the
     travel its content box lands 2px narrower than the text needs (the caret's
     border, under the global border-box), so a second word wraps to a line
     that height:100% then clips away — which is why one-word titles filled and
     "Career Timeline" never did. */
  .creative::before {
    content: attr(data-text);
    position: absolute;
    inset: 0;
    color: var(--colour-accent);
    -webkit-text-stroke: 0 #383d52;
  }

  /* The caret is its own layer now, so it can ride the wipe without taking
     width away from the text. */
  .creative::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 2px;
    background-color: var(--colour-accent);
    opacity: 0;
  }

  /* Armed from JS, so without it the title simply sits there filled. */
  .page-heading.is-armed .creative::before {
    clip-path: inset(0 100% 0 0);
  }

  .page-heading.is-wiping .creative::before {
    animation: heading-wipe 1s forwards ease-out;
  }

  .page-heading.is-wiping .creative::after {
    animation: heading-caret 1s forwards ease-out;
  }

  @keyframes heading-wipe {
    from {
      clip-path: inset(0 100% 0 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }

  @keyframes heading-caret {
    from {
      left: 0;
      opacity: 1;
    }
    99% {
      opacity: 1;
    }
    to {
      left: 100%;
      opacity: 0;
    }
  }

  .page-heading__description {
    color: #ffffff;
    font-size: 1.5rem;
    max-width: 70ch;
    margin: 1rem 0 0;
  }

  @media (max-width: 768px) {
    .page-heading__title { font-size: 2rem; }
    .page-heading__description { font-size: 1.25rem; }
    .creative { -webkit-text-stroke-width: 2px; }
  }

  @media (max-width: 576px) {
    .page-heading__title { font-size: 1.75rem; }
    .page-heading__description { font-size: 1.125rem; }
  }
</style>

<script>
  // Same arming trick as Reveal: no JS or reduced motion leaves the title
  // filled and the description simply there. The description types itself in
  // just behind the title's wipe.
  import { motionAllowed } from '../../lib/motion';
  import { armTypewriter, type Typewriter } from '../../lib/typewriter';

  /** Let the title's wipe lead before the text starts arriving. */
  const TYPE_DELAY = 260;

  const headings = [...document.querySelectorAll<HTMLElement>('[data-heading]')];

  if (motionAllowed() && 'IntersectionObserver' in window) {
    const typists = new Map<Element, Typewriter>();

    headings.forEach((el) => {
      el.classList.add('is-armed');
      const wrap = el.querySelector<HTMLElement>('[data-typed]');
      if (wrap) typists.set(el, armTypewriter(wrap));
    });

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('is-wiping');
          window.setTimeout(() => typists.get(entry.target)?.type(), TYPE_DELAY);
          observer.unobserve(entry.target);
        });
      },
      { threshold: 0.2 },
    );

    headings.forEach((el) => observer.observe(el));
  }
</script>
