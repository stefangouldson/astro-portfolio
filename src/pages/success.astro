---
import Layout from '../layouts/Layout.astro';
import PageHeading from '../components/ui/PageHeading.astro';

const description = 'Thank you for reaching out';
---

<Layout title="Success!" description={description}>
  <PageHeading title="Success!" description={description} />

  <section class="success">
    <svg class="checkmark" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 52 52" aria-hidden="true">
      <circle class="checkmark__circle" cx="26" cy="26" r="25" fill="none"></circle>
      <path class="checkmark__check" fill="none" d="M14.1 27.2l7.1 7.2 16.7-16.8"></path>
    </svg>
    <h2 class="typewriter">We will be in touch soon!</h2>
  </section>
</Layout>

<style>
  .success {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    min-height: 50vh;
    padding-bottom: 150px;
    background-color: #eeeeee;
  }

  .checkmark {
    width: 256px;
    height: 256px;
    max-width: 60vw;
    border-radius: 50%;
    display: block;
    stroke-width: 2;
    stroke: #7ac142;
    stroke-miterlimit: 10;
    margin: 15px auto;
    box-shadow: inset 0 0 0 #7ac142;
    animation:
      checkmark-fill 0.4s ease-in-out 0.4s forwards,
      checkmark-scale 0.3s ease-in-out 0.9s both;
  }

  .checkmark__circle {
    stroke-dasharray: 166;
    stroke-dashoffset: 166;
    stroke-width: 2;
    stroke-miterlimit: 10;
    stroke: #7ac142;
    fill: none;
    animation: checkmark-stroke 0.6s cubic-bezier(0.65, 0, 0.45, 1) forwards;
  }

  .checkmark__check {
    transform-origin: 50% 50%;
    stroke-dasharray: 48;
    stroke-dashoffset: 48;
    animation: checkmark-stroke 0.3s cubic-bezier(0.65, 0, 0.45, 1) 0.8s forwards;
  }

  @keyframes checkmark-stroke {
    100% { stroke-dashoffset: 0; }
  }

  @keyframes checkmark-scale {
    0%, 100% { transform: none; }
    50% { transform: scale3d(1.1, 1.1, 1); }
  }

  @keyframes checkmark-fill {
    100% { box-shadow: inset 0 0 0 30px #7ac142; }
  }

  .typewriter {
    color: #000000;
    overflow: hidden;
    border-right: 0.15em solid var(--colour-accent);
    white-space: nowrap;
    margin: 10px auto;
    letter-spacing: 0.1em;
    max-width: 100%;
    animation:
      typing 3.5s steps(30, end),
      blink-caret 0.5s step-end infinite;
  }

  @keyframes typing {
    from { width: 0; }
    to { width: 100%; }
  }

  @keyframes blink-caret {
    from, to { border-color: transparent; }
    50% { border-color: var(--colour-accent); }
  }

  @media (max-width: 576px) {
    .typewriter {
      font-size: 1rem;
      letter-spacing: 0.05em;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .checkmark,
    .checkmark__circle,
    .checkmark__check,
    .typewriter {
      animation: none;
    }

    .checkmark__circle,
    .checkmark__check {
      stroke-dashoffset: 0;
    }

    .typewriter {
      border-right: none;
    }
  }
</style>
