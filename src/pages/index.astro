---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/home/Hero.tsx';
import PageHeading from '../components/ui/PageHeading.astro';
import Reveal from '../components/ui/Reveal.astro';
import CardList from '../components/ui/CardList.astro';
import SkillsGrid from '../components/content/SkillsGrid.astro';
import TechStack from '../components/content/TechStack.astro';
import CareerTimeline from '../components/content/CareerTimeline.astro';
import WorkedWith from '../components/content/WorkedWith.astro';
import WorkedAt from '../components/content/WorkedAt.astro';
import ContactForm from '../components/content/ContactForm.tsx';
import { getProjects } from '../lib/contentful';
import '../components/home/hero.css';
import '../components/content/contact-form.css';

const aboutIntro =
  'As a mathematics graduate, software developer and infrastructure engineer, my focus lies in empowering businesses with custom-built software solutions that cater to their unique requirements.';

const careerIntro =
  'I have worked across several professions and disciplines before settling into software, and each one left something behind — a way of breaking down a problem, of talking to people, of shipping something that has to actually work. Here is the route so far.';

const projectsIntro =
  'Over the course of my professional journey, I have undertaken numerous projects, both as part of my employment and as personal initiatives which allowed me to hone my skills and expertise.';

const contactIntro =
  "Intrigued by what you've read? Eager to explore the possibilities of what we can create together? Don't hesitate to reach out and let's kick-start the conversation.";

const projects = await getProjects();
---

<Layout title="Software Developer" description={aboutIntro}>
  <div id="home">
    <Hero client:load />
  </div>

  <section id="about">
    <PageHeading title="About" description={aboutIntro} level={2} />

    <Reveal>
      <section class="secondaryBG content key-skills">
        <h3 class="section-title">Key Skills</h3>
        <p>
          I possess a range of skills, and highlighted below are some of my key proficiencies
          in software development
        </p>
        <SkillsGrid />
      </section>
    </Reveal>

    <TechStack />
  </section>

  <section id="career" class="primaryBG">
    <PageHeading title="Career Timeline" description={careerIntro} level={2} />
    <WorkedAt />
    <CareerTimeline />
  </section>

  <section id="projects">
    <PageHeading title="Projects" description={projectsIntro} level={2} />
    <WorkedWith />
    <CardList
      items={projects}
      base="/projects"
      empty="Projects are on their way back — check in soon."
    />
  </section>

  <section id="contact">
    <PageHeading title="Contact" description={contactIntro} level={2} />

    <Reveal>
      <section class="whiteBG content contact-section">
        <ContactForm client:load />
      </section>
    </Reveal>
  </section>
</Layout>

<style>
  .key-skills {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .key-skills h3 {
    margin-bottom: 0;
    color: var(--colour-bg);
  }

  .key-skills > p {
    color: var(--colour-bg);
    font-family: var(--font-body);
    max-width: 70ch;
    margin-bottom: 50px;
  }

  /* Last thing on the page — keep the nav button clear of the submit button. */
  .contact-section {
    padding-bottom: 150px;
  }

  @media (max-width: 768px) {
    .key-skills > p { margin-bottom: 30px; }
  }

  @media (max-width: 576px) {
    .key-skills > p { margin-bottom: 20px; }
  }
</style>
