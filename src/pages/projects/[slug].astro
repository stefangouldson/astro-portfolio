---
import Layout from '../../layouts/Layout.astro';
import PageHeading from '../../components/ui/PageHeading.astro';
import CardList from '../../components/ui/CardList.astro';
import Reveal from '../../components/ui/Reveal.astro';
import ProjectShot from '../../components/content/ProjectShot.astro';
import { getProjects } from '../../lib/contentful';
import { renderRichText } from '../../lib/rich-text';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project, more: projects.filter((other) => other.slug !== project.slug) },
  }));
}

const { project, more } = Astro.props;
const body = renderRichText(project.content);
// The description rides on the back of the screenshot; with no screenshot to
// turn over it stays under the title where it always was.
const shot = project.image;
---

<Layout
  title={project.title}
  description={project.description ?? project.title}
  ogImage={project.image}
>
  <PageHeading title={project.title} description={shot ? undefined : project.description} />

  {shot && <ProjectShot image={shot} title={project.title} description={project.description} />}

  {
    body && (
      <Reveal>
        <section class="secondaryBG">
          <div class="contentful-content" set:html={body} />
        </section>
      </Reveal>
    )
  }

  {more.length > 0 && <CardList title="More Projects" items={more} base="/projects" />}
</Layout>

<style>
  .secondaryBG {
    --rt-rule: #ffffff;
    color: var(--colour-bg);
  }
</style>
